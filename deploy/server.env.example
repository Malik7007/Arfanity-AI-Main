# Required image ref (used by docker-compose.server.yml)
IMAGE_REF=ghcr.io/your-github-user/your-repo:latest

# App
APP_PORT=8080
AI_NAME=Arfanity AI

# First admin user (created on first run)
AI_ADMIN_EMAIL=admin@example.com
AI_ADMIN_PASSWORD=change-this-now

# Security
ENABLE_SIGNUP=False

# Optional provider configuration
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
